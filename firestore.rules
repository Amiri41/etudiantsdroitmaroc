rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمين (نفس المعرّف لي فـ لوحة التحكم)
    function isAdmin() {
      return request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    // عداد (likes/comments) يقدر يتبدل غير بـ +1 ولا -1 من طرف شي واحد آخر
    function counterOk(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys()) ||
        math.abs(request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= 1;
    }

    // الطرف التاني فـ محادثة خاصة (participantUids فيها جوج)
    function otherParticipant(list) {
      return list[0] == request.auth.uid ? list[1] : list[0];
    }

    // المستخدم الموقوف (banned=true) ما يقدرش يكتب (منشور، تعليق، رسالة)
    function notBanned() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    match /debug_logs/{logId} {
      allow read: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'trace', 'timestamp', 'device']) &&
        request.resource.data.trace.size() <= 5000;
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";

      match /pdfs/{pdfId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorUid && notBanned();
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorUid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']) &&
          counterOk('likesCount') && counterOk('commentsCount'))
      );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin());

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.authorUid && notBanned();
        // صاحب التعليق ولا الأدمين يقدرو يمسحو
        allow delete: if request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin());
      }

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      // المستخدم ما يقدرش يبدل حقل banned ديالو
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('banned', false) != true;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('banned', false) == resource.data.get('banned', false);
      allow delete: if request.auth != null && request.auth.uid == uid;
      // الأدمين كيوقف ولا كيرفع الإيقاف (فقط هاد الحقول)
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'bannedAt', 'banReason']);

      match /friends/{friendUid} {
        allow read: if request.auth != null;
        // الإضافة: صاحب القائمة، ولا الطرف الآخر غير إلا كان عندو طلب صداقة منو (قبل ما يتمسح الطلب)
        allow create: if request.auth != null && (
          request.auth.uid == uid ||
          (request.auth.uid == friendUid &&
            exists(/databases/$(database)/documents/users/$(friendUid)/incoming_requests/$(uid)))
        );
        allow update, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // طلبات الصداقة الواردة (بحال فيسبوك: طلب ثم قبول/رفض)
      match /incoming_requests/{fromUid} {
        allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow create: if request.auth != null && request.auth.uid == fromUid;
      }

      // الأشخاص المحظورين من طرف هاد المستخدم
      match /blocked/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // إبلاغات عن محتوى/مستخدمين - أي مستخدم يقدر يبعت إبلاغ، وغير الأدمين يقدر يشوفهم ويديرهم
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterUid;
      allow read, update, delete: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    match /chat_threads/{threadId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participantUids);
      allow create: if request.auth != null && notBanned() &&
        request.auth.uid in request.resource.data.participantUids;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in resource.data.participantUids;
        allow create: if request.auth != null &&
          request.auth.uid in request.resource.data.participantUids &&
          request.auth.uid == request.resource.data.senderUid && notBanned() &&
          !exists(/databases/$(database)/documents/users/$(otherParticipant(request.resource.data.participantUids))/blocked/$(request.auth.uid));
        // المستقبل فقط يقدر يحدث حقول الوصول/القراءة (وصلات ✓✓ / تقراات ✓✓ زرقاء) وبلا ما يبدل أي شي آخر
        allow update: if request.auth != null &&
          request.auth.uid in resource.data.participantUids &&
          request.auth.uid != resource.data.senderUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'deliveredAt']);
        allow delete: if request.auth != null &&
          request.auth.uid in resource.data.participantUids;
      }
    }

    // collectionGroup: المستعمل يقدر يقرا غير التعليقات/الرسائل ديالو (باش يتمسحو ملي يحذف حسابو)
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }
    match /{path=**}/messages/{messageId} {
      allow read: if request.auth != null && resource.data.senderUid == request.auth.uid;
    }

    // بانر/إعلان تحكم من الأدمين، يبان للمستخدمين ملي يحلو التطبيق
    match /app_announcement/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    // فيديوهات تعليمية (يوتيوب) كيتحكم فيها الأدمين
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    // فصول ديناميكية (خاص بـ private/public)
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    match /videoChapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    match /videoSubjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    // إعدادات ظهور الأقسام الرئيسية
    match /app_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "pndM3rNT9DRVCPxODaHFFnBO9jU2";
    }

    // مجموعات المنتدى (بحال مجموعات واتساب) - كل واحد يقدر ينشئ، منشئها هو الأدمين ديالها
    match /forum_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorUid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorUid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorUid;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/forum_groups/$(groupId)).data.memberUids;
        allow create: if request.auth != null && notBanned() &&
          request.auth.uid in get(/databases/$(database)/documents/forum_groups/$(groupId)).data.memberUids;
        allow delete: if request.auth != null && (
          isAdmin() ||
          request.auth.uid == resource.data.senderUid ||
          request.auth.uid == get(/databases/$(database)/documents/forum_groups/$(groupId)).data.creatorUid
        );
      }
    }
  }
}
