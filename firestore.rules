rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /debug_logs/{logId} {
      allow read, write: if true;
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "zcSE6F8cMTM68kgKHM1SrH5KnX33";
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "zcSE6F8cMTM68kgKHM1SrH5KnX33";

      match /pdfs/{pdfId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == "zcSE6F8cMTM68kgKHM1SrH5KnX33";
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorUid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.authorUid;
      }

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /friends/{friendUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /chat_threads/{threadId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participantUids);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }
  }
}
