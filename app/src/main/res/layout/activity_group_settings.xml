<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/off_white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navy_dark"
        app:title="إعدادات المجموعة"
        app:titleTextColor="@color/gold"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivGroupIconPreview"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_forum"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:text="تغيير الشعار"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="اسم المجموعة"
                android:padding="12dp"
                android:background="@drawable/bg_input_field" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGroupDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="الوصف"
                android:minLines="3"
                android:gravity="top"
                android:padding="12dp"
                android:background="@drawable/bg_input_field" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGroupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="حفظ التعديلات"
                android:textAllCaps="false"
                app:backgroundTint="@color/gold"
                android:textColor="@color/navy_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 الأعضاء"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/navy_dark"
                android:layout_marginBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#E0E0E0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗑️ حذف المجموعة نهائيا"
                android:textAllCaps="false"
                app:backgroundTint="@color/red_accent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
