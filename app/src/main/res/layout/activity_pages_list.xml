<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="@drawable/bg_header_gold"
        android:paddingBottom="5dp"
        app:title="صفحات إضافية"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/ToolbarTitleBig"
        app:subtitle="اكتشف المزيد من الموارد التي تساعدك في مسارك القانوني"
        app:subtitleTextColor="#B8D4FF"
        app:subtitleTextAppearance="@style/ToolbarSubtitleSmall"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="معاً نحو مستقبل قانوني أفضل"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="76dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_brand_bar" />
    </LinearLayout>
</LinearLayout>
