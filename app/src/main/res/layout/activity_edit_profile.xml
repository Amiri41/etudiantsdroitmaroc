<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:background="@drawable/bg_header_gold"
        android:paddingBottom="5dp"
        app:title="تعديل البروفايل"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/ToolbarTitleBig"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="17dp"
            android:paddingBottom="17dp">

            <FrameLayout
                android:layout_width="121dp"
                android:layout_height="121dp"
                android:layout_gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar_ring">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="105dp"
                        android:layout_height="105dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:civ_border_width="4dp"
                        app:civ_border_color="#2F7BE0" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivEditPhoto"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_camera_badge_blue"
                    android:padding="9dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:minWidth="153dp"
                android:text="تغيير الصورة"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/chip_text"
                android:background="@drawable/bg_btn_soft_pill"
                app:backgroundTint="@null"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/chip_text"
                app:iconPadding="7dp"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="يمكنك اختيار صورة من جهازك"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الاسم الكامل"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="الاسم الكامل"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:padding="11dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/chip_text"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الجامعة/الكلية"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUniversity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="الجامعة/الكلية"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:padding="11dp"
                        android:src="@drawable/ic_account_balance"
                        app:tint="@color/chip_text"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="المستوى الدراسي"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="مثلا: S6، ماستر 1"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:padding="11dp"
                        android:src="@drawable/ic_school"
                        app:tint="@color/chip_text"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="حفظ التعديلات"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_save_button"
                app:backgroundTint="@null"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_save"
                app:iconTint="@color/white"
                app:iconPadding="8dp"
                app:iconGravity="textStart" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_login_wave"
        android:importantForAccessibility="no" />
</LinearLayout>
