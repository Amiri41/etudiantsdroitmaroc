<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login">

    <LinearLayout
        android:id="@+id/splashTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/bg_logo_circle"
            android:elevation="10dp"
            android:padding="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_emblem"
            android:contentDescription="@string/app_name"
            android:alpha="0" />

        <LinearLayout
            android:id="@+id/welcomeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:alpha="0">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_law_scale"
                app:tint="@color/gold"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مرحبا بيك فـ فضاء القانون"
                android:textColor="@color/login_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_brand_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ÉTUDIANTS EN DROIT MAROC"
                android:textColor="@color/login_subtitle"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:background="@drawable/bg_login_wave" />
</LinearLayout>
