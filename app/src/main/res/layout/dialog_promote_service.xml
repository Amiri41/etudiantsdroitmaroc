<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="روّج خدمتك معنا 📢"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/navy_dark"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عندك خدمة (كورسات، منتج، تطبيق...) وبغيتي تعلن عليها داخل التطبيق؟ عبي المعلومات وغادي نتواصلو معاك."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم الخدمة/المشروع"
            android:padding="12dp"
            android:background="@drawable/bg_input_field" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etServiceDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="وصف الخدمة اللي بغيتي تروج ليها"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_input_field" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etContactInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="رقم الهاتف أو الإيميل ديالك للتواصل"
            android:padding="12dp"
            android:background="@drawable/bg_input_field" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendPromoteRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="إرسال الطلب"
            android:textAllCaps="false"
            app:backgroundTint="@color/gold"
            android:textColor="@color/navy_dark" />

    </LinearLayout>
</ScrollView>
